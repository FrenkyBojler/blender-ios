# For some reason the auto formatter thinks this is python
# autopep8: off

# Support for vector types
type summary add "blender::char2" --python-script "debug_array = valobj.GetChildAtIndex(0).GetChildAtIndex(0).GetChildAtIndex(0).GetChildAtIndex(0); return 'uchar2{' + str(debug_array.GetChildAtIndex(0).GetValue()) + ', ' + str(debug_array.GetChildAtIndex(1).GetValue()) + '}'"
