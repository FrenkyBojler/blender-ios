#include "stdcycles.h"

shader node_curvature(int samples = 16,
                      float Radius = 0.01,
                      float Bias = 0.5,
                      int only_local = 0,
                      int independent = 0,
                      output float Curvature = 0.5,
                      output float Convexity = 0.0,
                      output float Concavity = 0.0,
                      output color Both = color(0.0, 0.0, 0.0))
{
  /* Abuse texture call with special @curvature token. */
  vector result = (color)texture("@curvature", samples, Radius, Bias, only_local, independent, 0);

  Curvature = result[0];
  Convexity = result[1];
  Concavity = result[2];
  Both = color(Convexity, Concavity, 0.0);
}
